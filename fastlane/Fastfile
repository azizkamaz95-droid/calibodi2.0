# fastlane/Fastfile — CaliBodi iOS App Store Pipeline

default_platform(:ios)

platform :ios do

  desc "Build et upload sur App Store Connect"
  lane :build_appstore do

    # ─── App Store Connect API Key ───────────────────────────────────────────
    api_key = app_store_connect_api_key(
      key_id:        ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:     ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content:   ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house:      false
    )

    # ─── Code Signing (Release only — on n'a pas de certificat Development) ──
    update_code_signing_settings(
      use_automatic_signing:  false,
      path:                   "ios/App/App.xcodeproj",
      bundle_identifier:      "com.calibodi.app",
      code_sign_identity:     "iPhone Distribution",
      profile_uuid:           ENV["PROFILE_UUID"],
      build_configurations:   ["Release"]
    )

    # ─── Build ───────────────────────────────────────────────────────────────
    build_app(
      project:          "ios/App/App.xcodeproj",
      scheme:           "App",
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "./build",
      output_name:      "CaliBodi.ipa",
      clean:            true,
      export_options: {
        method:               "app-store",
        signingStyle:         "manual",
        provisioningProfiles: {
          "com.calibodi.app" => ENV["PROFILE_UUID"]
        }
      }
    )

    # ─── Upload App Store Connect ─────────────────────────────────────────────
    upload_to_testflight(
      api_key:                 api_key,
      skip_waiting_for_build_processing: true
    )

    UI.success("🚀 CaliBodi uploadé avec succès sur App Store Connect !")
  end

end
